<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.socialseller.dummyapplication.ui.home.HomeFragment"
        android:label="Home" >
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addPlaceFragment"
            app:destination="@id/addPlaceFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.socialseller.dummyapplication.ui.home.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.socialseller.dummyapplication.ui.home.MapFragment"
        android:label="Map" />

    <fragment
        android:id="@+id/addPlaceFragment"
        android:name="com.socialseller.dummyapplication.ui.home.AddPlaceFragment"
        android:label="Add Place" />



    <!-- Add more screens as needed -->
</navigation>
